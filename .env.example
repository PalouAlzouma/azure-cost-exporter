# ==============================================================================
# Azure Cost Exporter : Variables d'environnement
#
# Copiez ce fichier et renommez-le .env :
#   cp .env.example .env
#
# Remplissez ensuite chaque valeur avec vos informations Azure.
# Ne committez jamais le fichier .env dans Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Obligatoire : identifiant de votre souscription Azure
# Commande pour le récupérer :
#   az account show --query "id" -o tsv
# ------------------------------------------------------------------------------
SUBSCRIPTION_ID=your-subscription-id

# ------------------------------------------------------------------------------
# Obligatoire : nom du resource group à surveiller
# Exemple : my-project-dev
# ------------------------------------------------------------------------------
RESOURCE_GROUP=your-resource-group-name

# ------------------------------------------------------------------------------
# Optionnel : label d'environnement ajouté à toutes les métriques Prometheus
# Valeurs recommandées : dev, staging, prod
# Défaut : chaîne vide
# ------------------------------------------------------------------------------
ENVIRONMENT=dev

# ------------------------------------------------------------------------------
# Optionnel : intervalle de collecte des coûts en secondes
# Valeur recommandée : 300 (5 minutes)
# Ne pas descendre en dessous de 60 pour éviter les limites de l'API Azure
# Défaut : 300
# ------------------------------------------------------------------------------
SCRAPE_INTERVAL=300